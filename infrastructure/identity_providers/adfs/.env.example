# AD FS identity provider configuration
# Copy this file to .env in the same directory, then update the required values:
#   cp .env.example .env
# The .env file is gitignored.

# ============================================================================
# Section 1: Active Directory and AD FS
# ============================================================================

# Required: existing EC2 key pair used to retrieve the Windows Administrator password.
ADFS_KEY_NAME=my-keypair

# Shared by the AD FS Role claim and the SAML identity provider created in Section 2.
# Change it here once; both setup scripts use the same value.
ADFS_SAML_PROVIDER_NAME=ADFS

# Network: choose one option.

# Option 1 (recommended): discover the VPC and subnets from the deployed Aurora CDK stack.
AURORA_STACK_NAME=aws-jdbc-driver-stack

# Option 2: skip Aurora stack discovery by setting both values below. When both are set,
# AURORA_STACK_NAME is ignored.
# ADFS_VPC_ID=vpc-xxxxxxxx
# ADFS_SUBNET_ID=subnet-xxxxxxxx

# Optional overrides. The values shown are the defaults.
# ADFS_DOMAIN_DNS_NAME=corp.example.com
# ADFS_DOMAIN_NETBIOS_NAME=CORP
# ADFS_INSTANCE_TYPE=m5.large
# ADFS_DSRM_SECRET_NAME=adfs/dc/restore-mode-password
# AWS_REGION=us-east-1

# Windows Server 2025 is used for the test domain controller. The Directory Services
# Restore Mode password is generated and stored in AWS Secrets Manager.

# ============================================================================
# Section 2: SAML identity provider and role in IAM
# Leave these settings commented while completing Section 1. Configure them after
# setup-adfs.ps1 generates FederationMetadata.xml.
# ============================================================================

# Path to FederationMetadata.xml. Default: FederationMetadata.xml in the current directory.
# ADFS_FEDERATION_METADATA_PATH=/path/to/FederationMetadata.xml

# The IAM role name must match the value emitted by the AD FS Role claim.
# ADFS_IAM_ROLE_NAME=ADFS-JDBCDemo

# The setup script reads ClusterResourceId from AURORA_STACK_NAME by default.
# Set this only to override discovery.
# AURORA_CLUSTER_RESOURCE_ID=cluster-xxxxxxxx

# Aurora IAM database user created in Stage 4. Default: db_iam_user.
# AURORA_IAM_DB_USERNAME=db_iam_user

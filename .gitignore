# CDK context files (hold real account/VPC/subnet ids) - anywhere in the tree
cdk.context.json
**/cdk.context.json

# CDK synthesized output - anywhere in the tree
cdk.out/
**/cdk.out/

# Internal security tooling state and scan output - never publish these
.protoshield/
.holmes/
semantic-review/
holmes-report-*.json

# Application properties with sensitive data
src/main/resources/application.properties
build/resources/main/application.properties

# Backup files
*.backup
*.bak

# Environment files
.env
.env.local
.env.*.local

# Generated AD FS federation metadata (environment-specific)
infrastructure/identity_providers/adfs/adfs_metadata/
infrastructure/identity_providers/adfs/scripts/FederationMetadata.xml

# AWS credentials
.aws/
credentials
config

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Build outputs
build/
target/
.gradle/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

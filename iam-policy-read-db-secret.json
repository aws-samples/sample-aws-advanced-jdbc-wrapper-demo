{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadGeneratedAuroraCredentials",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:aws-jdbc-driver-stack-*-credentials-*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "AWS-JDBC-Driver-Demo",
          "aws:ResourceTag/AutoDelete": "true"
        }
      }
    }
  ]
}
